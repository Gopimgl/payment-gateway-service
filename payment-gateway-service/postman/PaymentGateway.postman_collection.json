            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 200\", function(){ pm.response.to.have.status(200); });",
              "pm.test(\"Replay header\", function(){ pm.response.to.have.header(\"Idempotent-Replayed\",\"true\"); });"
            ]
          }
        }
      ]
    },
