{
  "info": {
    "name": "Payment Gateway Service",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 Create payment - SUCCESS (scenario SUCCESS)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{key1}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "payments"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"orderId\":\"ORD-1001\",\"amount\":1000.00,\"currency\":\"INR\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"key1\",\"key-\"+Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function(){ pm.response.to.have.status(201); });",
              "var j=pm.response.json(); pm.collectionVariables.set('paymentId', j.paymentId);",
              "pm.test('SUCCESS', function(){ pm.expect(j.status).to.eql('SUCCESS'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Replay same key + same body -> 200 (replayed)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
