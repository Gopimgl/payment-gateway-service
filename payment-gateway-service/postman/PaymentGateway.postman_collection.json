          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.request.body.raw;",
              "const sig = CryptoJS.HmacSHA256(body, \"mock-secret\").toString(CryptoJS.enc.Hex);",
              "pm.variables.set(\"sig\", sig);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
